{
  "name": "vpn-admin-desktop",
  "version": "1.0.0",
  "description": "VPN Server Admin Desktop Application",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run react-build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "axios": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^24.0.0",
    "electron-is-dev": "^2.0.0",
    "react-scripts": "5.0.1",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.vpn.admin",
    "productName": "VPN Admin",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
