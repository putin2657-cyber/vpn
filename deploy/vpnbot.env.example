# Copy to /opt/vpn/vpnbot.env on the VPS.

# From @BotFather — create a NEW bot for payments (separate from monitor alerts).
TELEGRAM_BOT_TOKEN=replace_me

# From @CryptoBot → Crypto Pay → your app (NOT the same as TELEGRAM_BOT_TOKEN).
CRYPTO_PAY_TOKEN=replace_me

VPBOT_DB=/opt/vpn/vpn.db
VPBOT_ADDR=127.0.0.1:8091
VPBOT_SYNC_CMD=/opt/vpn/sync-awg.sh

# Public URL path for Crypto Pay webhooks (full URL example):
#   https://138.249.141.164.sslip.io/webhook/cryptopay
CRYPTO_PAY_WEBHOOK_PATH=/webhook/cryptopay

# Personal SBP transfer (second payment option).
# Phone as +79001234567, bank as shown in the SBP app (Т-Банк / Сбер / …).
SBP_PHONE=+79001234567
SBP_BANK=Т-Банк
SBP_NAME=Имя Ф.

# Your Telegram numeric id(s) for one-tap SBP confirmation.
# In the bot send /myid — then paste the number here (comma-separated if several).
ADMIN_TELEGRAM_IDS=123456789

# Support chat and Android APK distribution.
SUPPORT_URL=https://t.me/ecstasyssssssss
ANDROID_APK_URL=https://138.249.141.164.sslip.io/FamilyVPN.apk
ANDROID_APK_PATH=/opt/vpn/downloads/FamilyVPN.apk

# Optional bot avatar (PNG/JPG) applied on startup.
BOT_AVATAR_PATH=/opt/vpn/downloads/familyvpn-bot-avatar.png
