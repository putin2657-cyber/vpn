# Copy to /opt/vpn/billing.env on the VPS and fill in real values.

YOOKASSA_SHOP_ID=replace_me
YOOKASSA_SECRET_KEY=replace_me

# Public HTTPS origin used for return_url and invite links (no trailing slash).
# Example with sslip.io while you have no domain:
# BILLING_PUBLIC_URL=https://138.249.141.164.sslip.io
BILLING_PUBLIC_URL=https://pay.example.com

BILLING_ADMIN_TOKEN=long_random_token
BILLING_ADDR=127.0.0.1:8088
BILLING_DB=/opt/vpn/vpn.db

# Applied after a peer is enabled/disabled by billing.
BILLING_SYNC_CMD=/opt/vpn/sync-awg.sh
